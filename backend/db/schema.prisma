generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  profileImage String?
  city      String?
  hometown  String?
  School    String? 
  password  String   // bcrypt hash, never store plain text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
