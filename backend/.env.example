# Local development example
# Copy this file to .env and fill in your actual values.

# Database Configuration
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/user_management?schema=public"

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for local development - use a strong random string
JWT_SECRET="your-secret-jwt-key-here-change-this"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
